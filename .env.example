# ============================================
# TrialGuard AI — Environment Configuration
# ============================================
# Copy this file to .env and update values for your environment

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://trialguard:trialguard_secret_2026@localhost:5432/trialguard_db
DATABASE_SYNC_URL=postgresql://trialguard:trialguard_secret_2026@localhost:5432/trialguard_db

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- JWT Authentication ----
JWT_SECRET_KEY=change-this-to-a-secure-random-string-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000

# ---- AWS S3 (Document Storage) ----
S3_BUCKET_NAME=trialguard-documents
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# ---- FAISS Vector Store ----
FAISS_INDEX_PATH=./data/faiss_indexes
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ---- OCR Service ----
OCR_ENGINE=tesseract
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=

# ---- Logging ----
LOG_LEVEL=INFO

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
